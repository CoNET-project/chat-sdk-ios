          "wallet.rec": "READABLE_EOA_MISMATCH_WITH_MARKER"
        }
      },
      "source": "E9.1-5（WK-42 启动期望）"
    },
    {
      "id": "E91-07",
      "title": "（f）残留意图标记与部分记录 + onboarding 后新账户写入 → 成功；旧产物全部在隔离名下，无删除，有审计",
      "policy": "decided",
      "pre": {
        "state": "onboarding_entered",
        "native": {
          "wallet.rec": "PARTIAL_OLD_REC",
          "wallet.mnem": "absent",
          "intent_marker": {
            "state": "active",
            "name": "wallet.discard.intent-or-wallet.isolation.pending"
          },
          "isolated_pattern": {
            "count": 0
          }
        }
      },
      "op": {
        "command": "pwaWalletSync",
        "trustedOrigin": true,
        "reqId": 21,
        "seq": 1,
        "eoa": "NEW_REC.eoa",
        "phrase": "<synthetic>"
      },
      "expect": {
        "answer": {
          "ok": true,
          "result.sync": "updated"
        },
        "pre_write_steps": [
          "isolate residue wallet.rec -> isolated_name (audit row, no delete)",
          "isolate active marker -> isolated_name (audit row, no delete)",
          "write new account per existing spec"
        ],
        "files": {
          "wallet.rec": "NEW_REC",
          "isolated_pattern": {
            "present": true,
            "count": 2,
            "contains": [
              "PARTIAL_OLD_REC",
              "active_marker"
            ]
          }
        },
        "deleted": [],
        "audit_append": [
          "isolate PARTIAL_OLD_REC",
          "isolate active marker",
          "write wallet.rec (sha NEW_REC)"
        ],
        "residue_blocks_write": false,
        "intent_marker": "cleared (active marker moved to isolated name)"
      },
      "source": "E9.1-6"
    },
    {
      "id": "E91-08",
      "title": "（f 失败分支）残留标记 + 写入失败 → 回 write_failed，全部数据保留（原件与隔离副本），无删除",
      "policy": "decided",
      "pre": {
        "state": "onboarding_entered",
        "native": {
          "wallet.rec": "PARTIAL_OLD_REC",
          "intent_marker": {
            "state": "active"
          },
          "isolated_pattern": {
            "count": 0
          }
        }
      },
      "op": {
        "command": "pwaWalletSync",
        "trustedOrigin": true,
        "reqId": 22,
        "seq": 1,
        "eoa": "NEW_REC.eoa",
        "phrase": "<synthetic>",
        "inject_fault": "storage_write_fails_after_isolation"
      },
      "expect": {
        "answer": {
          "ok": false,
          "error": "write_failed",
          "reason": "storage_write"
        },
        "files": {
          "isolated_pattern": {
            "present": true,
            "count": 2,
            "contains": [
              "PARTIAL_OLD_REC",
              "active_marker"
            ]
          }
        },
        "deleted": [],
        "audit_append": [
          "isolate PARTIAL_OLD_REC",
          "isolate active marker"
        ],
        "data_retained": true
      },
      "source": "E9.1-6 第 3 项"
    }
