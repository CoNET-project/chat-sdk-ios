  "extends": "spec-59e-errata-v3.3.1-E9.md (E9-01..E9-12) and spec-59e-errata-v3.3.1-E9.1.md (E91-01..E91-08)",
  "decision_source": "裁定 2026-11-17 (依原话 2026-11-17 与常设约束“不删数据”)",
  "fixtures_note": "Synthetic only. No real mnemonic, key or account. Digests are synthetic placeholders. 'isolated' means renamed to an isolation name with an audit row; nothing is deleted.",
  "cases": [
    {
      "id": "E91-01",
      "title": "REC 不可解密；助记词位置中仅 MNEM 为本次未完成写入且读取失败（半写）→ 忽略，其余可读为空 → onboarding",
      "policy": "decided",
      "pre": {
        "pwa": {
          "valid_mnemonic": false,
          "read": "ok"
        },
        "native": {
          "keystore_enumerate": "ok",
          "wallet.rec": "UNDECRYPTABLE (aead_failed); REC holds no mnemonic field",
          "wallet.mnem": "READ_FAILED",
          "intent_marker": {
            "state": "pending_unfinished_write",
            "target": "wallet.mnem"
          },
          "other_mnemonic_locations": "readable_empty"
        }
      },
      "op": {
        "command": "startup_classify",
        "pwa_preread_first": true
      },
      "expect": {
        "classification": "confirmed_no_valid_mnemonic",
        "answer_to_startup": "onboarding",
        "half_write_read_failure_ignored": true,
        "deleted": [],
        "files": {
          "wallet.rec": "UNDECRYPTABLE",
          "intent_marker": "retained"
        }
      },
      "source": "E9.1-1 第 1、2 项"
    },
    {
      "id": "E91-02",
      "title": "非未完成写入的 MNEM 读取失败（无标记指向它）→ unknown，保留，不进入 onboarding",
      "policy": "decided",
      "pre": {
        "pwa": {
          "valid_mnemonic": false,
          "read": "ok"
        },
        "native": {
          "keystore_enumerate": "ok",
          "wallet.rec": "READABLE_NO_MNEMONIC",
          "wallet.mnem": "READ_FAILED",
          "intent_marker": "absent",
          "other_mnemonic_locations": "readable_empty"
        }
      },
      "op": {
        "command": "startup_classify",
        "pwa_preread_first": true
      },
      "expect": {
        "classification": "unknown",
        "answer_to_startup": "retain_and_retry",
        "onboarding_entered": false,
        "deleted": []
      },
      "source": "E9.1-1 第 2 项（不属于未完成写入的读取失败）"
    },
    {
      "id": "E91-03",
      "title": "钥库不可用，或需要用户解锁 → unknown，保留，不进入 onboarding",
      "policy": "decided",
      "pre": {
        "pwa": {
          "valid_mnemonic": false,
          "read": "ok"
        },
        "native": {
          "keystore_enumerate": "unavailable_or_requires_user_unlock",
          "mnemonic_locations_read": "not_read"
        }
      },
      "op": {
        "command": "startup_classify",
        "pwa_preread_first": true
      },
      "expect": {
        "classification": "unknown",
        "answer_to_startup": "retain_and_retry",
        "onboarding_entered": false,
        "deleted": []
      },
      "source": "E9.1-1 第 2 项（钥库不可用或需解锁）"
    },
    {
