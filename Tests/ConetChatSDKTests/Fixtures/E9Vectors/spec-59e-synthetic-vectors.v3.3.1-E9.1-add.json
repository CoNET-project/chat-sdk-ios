      "expect": [
        {
          "case": "a",
          "walletStatus": "no_key",
          "startup": "onboarding"
        },
        {
          "case": "b",
          "walletStatus": {
            "status": "not_ready",
            "notReadyReason": "unreadable"
          },
          "startup": "retain_and_retry"
        }
      ],
      "source": "E9.1-4；不改 §25.52CS.2 (a) 对族命令的规定"
    },
    {
      "id": "E91-06",
      "title": "WK-42 启动期望：原名可读、EOA 与标记不一致，无有效助记词 → onboarding",
      "policy": "decided",
      "pre": {
        "pwa": {
          "valid_mnemonic": false,
          "read": "ok"
