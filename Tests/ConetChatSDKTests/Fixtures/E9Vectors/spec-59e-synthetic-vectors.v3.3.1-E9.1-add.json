      },
      "op": {
        "command": "startup_classify",
        "pwa_preread_first": true
      },
      "expect": {
        "classification": "confirmed_no_valid_mnemonic",
        "answer_to_startup": "onboarding",
        "deleted": []
      },
      "source": "E9.1-3"
    },
    {
      "id": "E91-05",
      "title": "walletStatus 应答与分类一致：确认无有效助记词 → no_key；读取失败 → unknown（not_ready/unreadable）",
      "policy": "decided; family command rules unchanged",
      "pre": [
        {
          "case": "a",
          "native_classification": "confirmed_no_valid_mnemonic"
        },
        {
          "case": "b",
          "native_classification": "unknown_read_failure"
