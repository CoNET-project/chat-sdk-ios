        "native": {
          "keystore_enumerate": "ok",
          "wallet.rec": "READABLE_NO_MNEMONIC",
          "wallet.mnem": "absent",
          "intent_marker": "mismatch_with_rec",
          "mnemonic_locations_read": "all_ok",
          "mnemonic_locations_valid": 0
